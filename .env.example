DISCORD_TOKEN=
FFMPEG_PATH=./ffmpeg/bin/ffmpeg.exe
MINIMAX_API_KEY=

# 人格自動回覆
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# 逗號分隔的伺服器 ID。設定後只會在這些伺服器回覆，私訊也會停用。
AI_GUILD_IDS=
# 逗號分隔的頻道 ID。留空時只回覆提及、回覆機器人及私訊。
AI_CHANNEL_IDS=
# 在上述指定頻道主動插話的機率（0 到 1）。
AI_REPLY_CHANCE=0.25

# 多層限頻：未通過檢查的訊息不會呼叫模型。
AI_USER_COOLDOWN_SECONDS=30
AI_CHANNEL_COOLDOWN_SECONDS=5
AI_GLOBAL_REQUESTS_PER_MINUTE=20
AI_GLOBAL_REQUESTS_PER_HOUR=100
AI_MAX_CONCURRENT_REQUESTS=2
# 每位使用者在每個伺服器的每日觸發上限，預設 UTC+8 午夜重置。
AI_USER_DAILY_LIMIT=20
AI_DAILY_TIMEZONE_OFFSET_HOURS=8
# 可略過上述限頻的 Discord 使用者 ID，以逗號分隔；留空代表無人豁免。
AI_RATE_LIMIT_BYPASS_USER_IDS=

# 每個頻道保存的近期訊息筆數（所有非機器人文字及安安的回覆）。
AI_HISTORY_SIZE=20
AI_MAX_INPUT_CHARS=1000
AI_MAX_OUTPUT_TOKENS=250

# SQLite 長期記憶（依伺服器及使用者隔離）
AI_MEMORY_DB=data/memory.db
AI_MEMORY_MAX_PER_USER=100
AI_MEMORY_RECALL_LIMIT=5
AI_AUTO_MEMORY=true

# 好感度每天最多自動變動幾次；範圍固定為 -100 到 100。
AI_AFFINITY_DAILY_CHANGES=3
