DISCORD_TOKEN=
FFMPEG_PATH=./ffmpeg/bin/ffmpeg.exe
MINIMAX_API_KEY=
MINIMAX_VOICE_ID=moss_audio_8434cf0e-cc87-11f0-9bff-daa50e7d99bd
MINIMAX_TTS_MODEL=speech-2.6-turbo

# 人格自動回覆
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# 網頁搜尋使用支援 Web Search 的獨立模型，不影響一般聊天模型。
OPENAI_SEARCH_MODEL=gpt-5.4-mini
AI_WEB_SEARCH_ENABLED=true
# 每位使用者在每個伺服器每天可觸發的網頁搜尋次數。
AI_WEB_SEARCH_DAILY_LIMIT=2

# 逗號分隔的伺服器 ID。設定後只會在這些伺服器回覆，私訊也會停用。
AI_GUILD_IDS=
# 逗號分隔的頻道 ID。留空時只回覆提及、回覆機器人及私訊。
AI_CHANNEL_IDS=
# 在上述指定頻道主動插話的機率（0 到 1）。
AI_REPLY_CHANCE=0.25
# 使用者直接提及或回覆安安時的基礎回覆機率；受好感度影響，上限為 100%。
AI_DIRECT_REPLY_CHANCE=1.0

# 多層限頻：未通過檢查的訊息不會呼叫模型。
AI_USER_COOLDOWN_SECONDS=30
AI_CHANNEL_COOLDOWN_SECONDS=5
AI_GLOBAL_REQUESTS_PER_MINUTE=20
AI_GLOBAL_REQUESTS_PER_HOUR=100
AI_MAX_CONCURRENT_REQUESTS=2
# 每位使用者在每個伺服器的每日觸發上限，預設 UTC+8 午夜重置。
AI_USER_DAILY_LIMIT=20
AI_DAILY_TIMEZONE_OFFSET_HOURS=8
# 可略過上述限頻的 Discord 使用者 ID，以逗號分隔；留空代表無人豁免。
AI_RATE_LIMIT_BYPASS_USER_IDS=

# 每個頻道保存的近期訊息筆數（所有非機器人文字及安安的回覆）。
AI_HISTORY_SIZE=20
AI_MAX_INPUT_CHARS=1000
AI_MAX_OUTPUT_TOKENS=250

# SQLite 稱謂、好感度及參與者印象（依伺服器及使用者隔離）
AI_MEMORY_DB=data/memory.db
# 每成功回覆固定次數後，批次用 GPT 更新該伺服器每位參與者的互動印象。
AI_MEMORY_SUMMARY_ENABLED=true
AI_MEMORY_SUMMARY_INTERVAL=10
# 單次最多整理的聊天片段；模型預設沿用 OPENAI_MODEL。
AI_MEMORY_SUMMARY_BATCH_SIZE=200
AI_MEMORY_SUMMARY_MAX_OUTPUT_TOKENS=2000
AI_MEMORY_SUMMARY_MODEL=gpt-4.1-mini

# 好感度每天最多自動變動幾次；範圍固定為 -100 到 100。
AI_AFFINITY_DAILY_CHANGES=3

# 人格回覆媒體。預設只有直接提及／回覆時能使用，隨機插話只傳文字。
AI_IMAGE_REPLIES_ENABLED=true
AI_VOICE_REPLIES_ENABLED=true
AI_MEDIA_DIRECT_ONLY=true
# 圖片過長或仍在冷卻時會自動退回文字。
AI_IMAGE_MAX_CHARS=180
AI_IMAGE_COOLDOWN_SECONDS=30
# MiniMax TTS 過長、仍在冷卻或達每日上限時會自動退回文字。
AI_TTS_MAX_CHARS=100
AI_TTS_COOLDOWN_SECONDS=120
AI_TTS_USER_DAILY_LIMIT=5
AI_TTS_GUILD_DAILY_LIMIT=30
