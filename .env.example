# 密鑰（請勿提交實際值）
DISCORD_TOKEN=
OPENAI_API_KEY=
MINIMAX_API_KEY=

# 斜線指令同步：留空先清除本 bot 在全部伺服器的舊指令，再更新全域。
# 填入逗號分隔的伺服器 ID，則只同步到指定伺服器，保留既有全域指令。
# 此設定與 AI_GUILD_IDS（AI 回覆範圍）無關。
DISCORD_SYNC_GUILD_IDS=

# 部署路徑
FFMPEG_PATH=./ffmpeg/bin/ffmpeg.exe
AI_MEMORY_DB=data/memory.db

# 逗號分隔的伺服器 ID。設定後只會在這些伺服器回覆，私訊也會停用。
AI_GUILD_IDS=
# 逗號分隔的頻道 ID。留空時只回覆提及、回覆機器人及私訊。
AI_CHANNEL_IDS=
# 討伐活動專用文字頻道 ID，逗號分隔。留空不會自動發布怪物。
RPG_RAID_CHANNEL_IDS=
# 可略過 AI 限頻的 Discord 使用者 ID，以逗號分隔；留空代表無人豁免。
AI_RATE_LIMIT_BYPASS_USER_IDS=

# 模型、回覆機率、每日額度與語音等設定請修改 config/settings.toml。
# 詳細說明見 config/README.md；修改後重啟生效。
